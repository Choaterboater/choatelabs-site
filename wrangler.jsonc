{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "choatelabs-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /casper/* has no files here; the Worker passes it to GitHub Pages.
    // Without this, browser page loads get 404.html before the Worker runs.
    "run_worker_first": ["/casper", "/casper/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "LUMINA_DB",
      "database_name": "lumina-leaderboard",
      "database_id": "8fe6ce8f-73f5-4193-86ed-4d9cda29d24d"
    }
  ]
}

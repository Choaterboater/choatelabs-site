{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "choatelabs-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every path the Worker answers. A list here is the whole set: any other
    // path is static files only, and a miss gets 404.html without the Worker.
    // /casper is listed so browser page loads reach the Worker too.
    "run_worker_first": ["/lumina/api/*", "/casper", "/casper/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "LUMINA_DB",
      "database_name": "lumina-leaderboard",
      "database_id": "8fe6ce8f-73f5-4193-86ed-4d9cda29d24d"
    }
  ]
}
